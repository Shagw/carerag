# ============================================================================
# .env.example — a TEMPLATE for your secrets and settings.
#
# This file is SAFE to share / commit: it contains only placeholder values,
# no real secrets.
#
# WHAT YOU DO:
#   1. Make a copy of this file named exactly ".env"   ->  cp .env.example .env
#   2. Open YOUR .env and replace the placeholders with your real values.
#   3. Never share or commit your .env (it is git-ignored for you).
#
# The app reads these values at startup (see app/config.py).
# ============================================================================


# --- Database (Supabase Postgres) -------------------------------------------
# Your Supabase connection string. You get this from the Supabase dashboard:
#   Project Settings -> Database -> Connection string -> URI
# It looks like:  postgresql://postgres:YOUR-PASSWORD@db.xxxx.supabase.co:5432/postgres
# Replace the whole thing with your real URI.
DATABASE_URL=postgresql://user:password@host:5432/postgres


# --- Gemini API keys (up to 5, for rotation) --------------------------------
# You can provide between 1 and 5 keys. The app rotates them: if one key hits
# its free-tier limit, it "cools down" and the next key is used.
#
# Get free keys at https://aistudio.google.com/app/apikey  (no credit card).
# Fill in as many as you have; leave the rest blank.
#
# NOTE: we keep them as separate numbered variables to keep things simple.
GEMINI_API_KEY_1=your-first-gemini-key-here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=


# --- Optional tuning knobs (safe defaults; you usually don't change these) ---
# How many top matching chunks to retrieve for each question.
TOP_K=5

# Strict "I don't know" threshold. If even the best chunk's cosine distance is
# ABOVE this number, we treat the documents as not containing the answer and
# reply "I don't know". Lower = stricter. (0.0 = identical, 2.0 = opposite.)
# 0.8 is calibrated so real answers pass but off-topic questions are refused.
SIMILARITY_THRESHOLD=0.8

# The URL where the FastAPI backend runs. The Streamlit UI calls this.
# For local development this default is correct.
API_BASE_URL=http://localhost:8000
